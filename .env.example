# ============================================================
# UIAP — Unified Identity & Access Platform
# Non-secret configuration template (P0.3 baseline)
#
# Rules (per ARCHITECTURE.md v1.0.1 §41.4 / §54.1):
#   - NEVER place real credentials, tokens, passwords, keys, or
#     production secrets in this file or in any committed file.
#   - Copy to `.env` for local use; `.env` is git-ignored.
#   - ACTIVE variables are read by committed code (see reader column).
#   - RESERVED variables are declared for later sub-phases and have
#     NO reader yet — setting them today has no effect.
#   - Real deployments inject secrets via KMS/Vault, not env files.
# ============================================================

# --- ACTIVE (has a real reader in code) --------------------------------=====

# Environment identity (§54.1). IDENTITY ONLY — it never selects the settings
# module. Unset is tolerated; a wrong value fails loudly.
# Reader: config/settings/base.py
# One of: dev | test | staging | prod
UIAP_ENV=dev

# Django settings selection — the ONLY selector contract.
# manage.py defaults to dev locally; config/asgi.py and config/wsgi.py
# REQUIRE this variable explicitly (no dev fallback) — set it per process.
# Reader: manage.py, config/asgi.py, config/wsgi.py
DJANGO_SETTINGS_MODULE=config.settings.dev

# Development DEBUG flag (dev only; staging/prod are hard-off regardless).
# Strict boolean: true/false only — anything else fails loudly.
# Reader: config/settings/dev.py
DJANGO_DEBUG=true

# Development allowed hosts (comma-separated). Unset -> localhost defaults;
# set-but-empty -> no hosts (fail-closed).
# Reader: config/settings/dev.py
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Staging/prod allowed hosts (comma-separated). Unset or empty -> no hosts
# (fail-closed).
# Reader: config/settings/_env.py (env_host_list)
UIAP_ALLOWED_HOSTS=

# SECRET (staging/prod): injected via KMS/Vault in real deployments — the
# empty placeholder here is for local skeleton testing ONLY. Missing or empty
# value is a boot error (fail-fast).
# Reader: config/settings/_env.py (required_secret)
UIAP_SECRET_KEY=

# --- RESERVED (documented for later sub-phases; NO reader yet) ==============

# Issuer / OIDC — sub-phase: OIDC plane. OQ-01 (§59) is OPEN; no value may be
# invented. Reader: none yet (RESERVED).
UIAP_ISSUER=

# PostgreSQL 17 (§34.1) — sub-phase: database foundation. Readers: none yet.
UIAP_DB_HOST=localhost
UIAP_DB_PORT=5432
UIAP_DB_NAME=uiap
UIAP_DB_USER=
UIAP_DB_PASSWORD=

# Valkey / Redis protocol store (§35.3; OQ-12 default: Valkey) — sub-phase:
# cache foundation. Reader: none yet.
UIAP_CACHE_URL=redis://localhost:6379/0

# Vault / KMS (§41.1, §41.4) — sub-phase: secrets/KMS integration. Reader:
# none yet. The token is a SECRET: never commit a real value.
UIAP_VAULT_ADDR=http://localhost:8200
UIAP_VAULT_TOKEN=

# Observability (§45) — sub-phase: observability foundation. Reader: none yet.
UIAP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
