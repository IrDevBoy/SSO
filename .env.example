# ============================================================
# UIAP — Unified Identity & Access Platform
# Non-secret configuration template (P0.0 baseline)
#
# Rules (per ARCHITECTURE.md v1.0.1 §41.4 / §54.1):
#   - NEVER place real credentials, tokens, passwords, keys, or
#     production secrets in this file or in any committed file.
#   - Copy to `.env` for local use; `.env` is git-ignored.
#   - Values not established by the architecture are left empty
#     or carry an explicit placeholder — nothing is invented here.
# ============================================================

# --- Runtime environment (§54.1 environment isolation) ---
# One of: dev | staging | prod  (test is CI-only)
UIAP_ENV=dev

# --- Django ---
# Non-secret runtime flag; SECRET_KEY is NEVER set here (§41.4 — secrets
# come from KMS/Vault injection, not env files).
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Issuer / OIDC (§15.6, OQ-01 OPEN) ---
# OQ-01 (final issuer domain + hosting model) is an OPEN question.
# No production issuer value is established; do not invent one.
UIAP_ISSUER=

# --- PostgreSQL 17 (§34.1) ---
# Local dev defaults only; production credentials come from Vault/KMS.
UIAP_DB_HOST=localhost
UIAP_DB_PORT=5432
UIAP_DB_NAME=uiap
UIAP_DB_USER=
UIAP_DB_PASSWORD=

# --- Valkey / Redis protocol store (§35.3; OQ-12 default: Valkey) ---
UIAP_CACHE_URL=redis://localhost:6379/0

# --- Vault / KMS (§41.1, §41.4) ---
# Address of the dev Vault instance only — no tokens, no secrets here.
UIAP_VAULT_ADDR=http://localhost:8200
UIAP_VAULT_TOKEN=

# --- Observability (§45) ---
# Endpoint of the local OTel collector; no SaaS keys in env files.
UIAP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
