[TEMPLATE]
# ============================================================
# UIAP — Unified Identity & Access Platform
# Non-secret configuration template (P0.4 baseline)
#
# Rules (per ARCHITECTURE.md v1.0.1 §41.4 / §54.1):
#   - NEVER place real credentials, tokens, passwords, keys, or
#     production secrets in this file or in any committed file.
#   - Copy to `.env` for local use; `.env` is git-ignored.
#   - ACTIVE variables are read by committed code (see reader column).
#   - RESERVED variables are declared for later sub-phases and have
#     NO reader yet — setting them today has no effect.
#   - Real deployments inject secrets via KMS/Vault, not env files.
# ============================================================

# --- ACTIVE (has a real reader in code) --------------------------------=====

# Environment identity (§54.1). IDENTITY ONLY — it never selects the settings
# module. Unset is tolerated; a wrong value fails loudly.
# Reader: config/settings/base.py
# One of: dev | test | staging | prod
UIAP_ENV=dev

# Django settings selection — the ONLY selector contract.
# manage.py defaults to dev locally; config/asgi.py and config/wsgi.py
# REQUIRE this variable explicitly (no dev fallback) — set it per process.
# Reader: manage.py, config/asgi.py, config/wsgi.py
DJANGO_SETTINGS_MODULE=config.settings.dev

# Development DEBUG flag (dev only; staging/prod are hard-off regardless).
# Strict boolean: true/false only — anything else fails loudly.
# Reader: config/settings/dev.py
DJANGO_DEBUG=true

# Development allowed hosts (comma-separated). Unset -> localhost defaults;
# set-but-empty -> no hosts (fail-closed).
# Reader: config/settings/dev.py
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Staging/prod allowed hosts (comma-separated). Unset or empty -> no hosts
# (fail-closed).
# Reader: config/settings/_env.py (env_host_list)
UIAP_ALLOWED_HOSTS=

# SECRET (staging/prod): injected via KMS/Vault in real deployments — the
# empty placeholder here is for local skeleton testing ONLY. Missing or empty
# value is a boot error (fail-fast).
# Reader: config/settings/_env.py (required_secret)
UIAP_SECRET_KEY=

# PostgreSQL 17 (§34.1) — P0.4 database foundation. Readers:
# config/settings/base.py (DATABASES). staging/prod fail closed when a
# required value is missing/empty; dev/test keep neutral local defaults
# (localhost/5432/uiap) so checks and the unit tier boot without a server.
# UIAP_DB_PASSWORD is credential material: it must arrive via env/KMS/Vault
# injection — the placeholder here stays empty by rule, never filled in.
# Reader: config/settings/base.py
UIAP_DB_HOST=localhost
UIAP_DB_PORT=5432
UIAP_DB_NAME=uiap
UIAP_DB_USER=
UIAP_DB_PASSWORD=

# libpq sslmode for the PostgreSQL connection (disable | allow | prefer |
# require | verify-ca | verify-full). Unset -> prefer (psycopg/libpq
# default posture); staging/prod SHOULD pin verify-full in deployment config.
# Reader: config/settings/base.py
UIAP_DB_SSLMODE=prefer

# Event relay (P0.7 — §29.4, ADR-0005) — ACTIVE: read by relay/__main__.py and
# core/outbox/conf.py. The relay is a separate process (`python -m relay`, §8.2);
# these variables are meaningless for the web/Celery processes.
#
# CloudEvents `source` for envelopes built from outbox rows. OQ-01 (§59) is
# OPEN: no issuer/source value may be invented — set this only to a value
# verified by deployment config. Placeholder stays empty by rule.
# Behavior: REQUIRED — the relay refuses to boot without it (exit 2,
# fail-closed, §41.4); envelope construction refuses to publish without it.
# Reader: relay/__main__.py (boot), core/outbox/envelope.py (publish).
UIAP_RELAY_SOURCE=

# Valkey (Redis-protocol) connection URL for the relay process. This is the
# relay's OWN connection — distinct from UIAP_CACHE_URL (cache sub-phase) and
# NOT related to UIAP_RELAY_SOURCE (envelope identity); no conflation.
# Credential material if auth is enabled: inject via env/KMS/Vault, never commit.
# Behavior: REQUIRED — the relay refuses to boot without it (exit 2, §41.4).
# Reader: relay/__main__.py
UIAP_RELAY_URL=

# Stream / consumer-group / consumer names (PD-8: config-backed, no invented
# literals in code). Staging/prod run strict (fail-closed on missing/empty).
# Dev/test-only defaults exist in core/outbox/conf.py — documented there, not
# set here, so production never silently inherits a local default.
# Reader: core/outbox/conf.py (strict mode for the relay process)
UIAP_RELAY_STREAM=
UIAP_RELAY_GROUP=
UIAP_RELAY_CONSUMER=

# Claim batch size (rows claimed per SKIP LOCKED cycle) and XAUTOCLAIM
# min-idle-time in ms (PD-7: tunable, not an architectural invariant).
# Behavior: positive integers; zero/negative/empty fail closed in strict mode.
# Reader: core/outbox/conf.py
UIAP_RELAY_CLAIM_BATCH=
UIAP_RELAY_IDLE_MS=

# --- RESERVED (documented for later sub-phases; NO reader yet) ==============

# Issuer / OIDC — sub-phase: OIDC plane. OQ-01 (§59) is OPEN; no value may be
# invented. Reader: none yet (RESERVED).
UIAP_ISSUER=

# Valkey / Redis protocol store (§35.3; OQ-12 default: Valkey) — sub-phase:
# cache foundation. Reader: none yet.
UIAP_CACHE_URL=redis://localhost:6379/0

# Vault / KMS (§41.1, §41.4) — sub-phase: secrets/KMS integration. Reader:
# none yet. The token is a SECRET: never commit a real value.
UIAP_VAULT_ADDR=http://localhost:8200
UIAP_VAULT_TOKEN=

# Observability (§45) — sub-phase: observability foundation. Reader: none yet.
UIAP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
